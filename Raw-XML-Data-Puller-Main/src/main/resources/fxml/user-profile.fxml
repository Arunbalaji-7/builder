<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.walgreens.rawxmldatapuller.controller.UserProfileController"
      styleClass="root-container" spacing="0">

    <!-- Full-width identity header — compact so Change Password fits without scrolling -->
    <VBox styleClass="profile-header" alignment="CENTER" spacing="6">
        <padding><Insets top="14" right="32" bottom="14" left="32"/></padding>
        <StackPane alignment="CENTER">
            <Region styleClass="avatar-circle"/>
            <Label fx:id="avatarLabel" styleClass="avatar-initials"/>
        </StackPane>
        <Label fx:id="fullNameLabel" styleClass="profile-fullname"/>
        <HBox alignment="CENTER" spacing="10">
            <Label fx:id="usernameLabel" styleClass="profile-username"/>
            <Label fx:id="roleLabel"     styleClass="role-badge"/>
        </HBox>
    </VBox>

    <!-- Scrollable content — card is centered via TOP_CENTER + maxWidth -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
        <VBox alignment="TOP_CENTER" spacing="0" styleClass="content-area">
            <padding><Insets top="28" right="24" bottom="28" left="24"/></padding>

            <!-- Change Password card — maxWidth keeps it compact and centered -->
            <VBox styleClass="card" spacing="14" maxWidth="480">
                <Label text="Change Password" styleClass="card-title"/>

                <VBox spacing="5">
                    <Label text="Current Password" styleClass="field-label"/>
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <PasswordField fx:id="currentPwdField" styleClass="input-field"
                                       promptText="Enter current password" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="currentPwdFieldTxt" styleClass="input-field"
                                   promptText="Enter current password" HBox.hgrow="ALWAYS"
                                   visible="false" managed="false"/>
                        <Button fx:id="currentPwdToggleBtn" onAction="#toggleCurrentPwdVisibility"
                                focusTraversable="false"
                                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 6 10 6 10;"/>
                    </HBox>
                </VBox>
                <VBox spacing="5">
                    <Label text="New Password" styleClass="field-label"/>
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <PasswordField fx:id="newPwdField" styleClass="input-field"
                                       promptText="Min. 8 characters" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="newPwdFieldTxt" styleClass="input-field"
                                   promptText="Min. 8 characters" HBox.hgrow="ALWAYS"
                                   visible="false" managed="false"/>
                        <Button fx:id="newPwdToggleBtn" onAction="#toggleNewPwdVisibility"
                                focusTraversable="false"
                                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 6 10 6 10;"/>
                    </HBox>
                    <!-- Password strength criteria — shown while typing -->
                    <VBox fx:id="pwdCriteriaPane" spacing="3"
                          style="-fx-padding: 6 4 2 4; -fx-background-color: #f8f9fa; -fx-border-color: #e0e0e0; -fx-border-radius: 4; -fx-background-radius: 4;"
                          visible="false" managed="false">
                        <Label fx:id="critLength"  text="✗  Minimum 8 characters"          style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                        <Label fx:id="critUpper"   text="✗  At least one uppercase letter"  style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                        <Label fx:id="critLower"   text="✗  At least one lowercase letter"  style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                        <Label fx:id="critNumber"  text="✗  At least one number"            style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                        <Label fx:id="critSpecial" text="✗  At least one special character" style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </VBox>
                <VBox spacing="5">
                    <Label text="Confirm New Password" styleClass="field-label"/>
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <PasswordField fx:id="confirmPwdField" styleClass="input-field"
                                       promptText="Repeat new password" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="confirmPwdFieldTxt" styleClass="input-field"
                                   promptText="Repeat new password" HBox.hgrow="ALWAYS"
                                   visible="false" managed="false"/>
                        <Button fx:id="confirmPwdToggleBtn" onAction="#toggleConfirmPwdVisibility"
                                focusTraversable="false"
                                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-padding: 6 10 6 10;"/>
                    </HBox>
                </VBox>

                <Label fx:id="pwdStatusLabel" wrapText="true"
                       visible="false" managed="false"/>

                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="changePwdBtn" text="Update Password"
                            styleClass="search-btn" onAction="#handleChangePassword"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
